u0441\u0442 \u0432 \u043c\u0435\u0442\u0440\u0430\u0445"},{"location":"developer/api/#_2","title":"\u041c\u0435\u0442\u043e\u0434\u044b","text":""},{"location":"developer/api/#calculateage","title":"<code>CalculateAge()</code>","text":"<p>\u0412\u044b\u0447\u0438\u0441\u043b\u044f\u0435\u0442 \u0432\u043e\u0437\u0440\u0430\u0441\u0442 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430.</p> <ul> <li>\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442: <code>int</code></li> </ul>"},{"location":"developer/api/#calculatebmi","title":"<code>CalculateBMI()</code>","text":"<p>\u0412\u044b\u0447\u0438\u0441\u043b\u044f\u0435\u0442 \u0438\u043d\u0434\u0435\u043a\u0441 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430.</p> <p>\u0424\u043e\u0440\u043c\u0443\u043b\u0430:</p> <p>$$ I = \\frac{m}{h^2} $$</p> <ul> <li>\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442: <code>double</code></li> <li>\u0418\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f:</li> <li><code>DivideByZeroException</code> \u2014 \u0435\u0441\u043b\u0438 <code>Height &lt;= 0</code></li> </ul> <p>[!WARNING] \u041f\u0435\u0440\u0435\u0434 \u0432\u044b\u0437\u043e\u0432\u043e\u043c \u043c\u0435\u0442\u043e\u0434\u0430 \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e Height \u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e.</p>"},{"location":"gost/00-title/","title":"00 title","text":"\u0423\u0422\u0412\u0415\u0420\u0416\u0414\u0415\u041d <p>\u0410\u0411\u0412\u0413.00001-01 81 01-\u041b\u0423</p> <p></p> \u0421\u0418\u0421\u0422\u0415\u041c\u0410 \u0423\u041f\u0420\u0410\u0412\u041b\u0415\u041d\u0418\u042f \u041a\u041b\u0418\u041d\u0418\u041a\u041e\u0419 \u0420\u0423\u041a\u041e\u0412\u041e\u0414\u0421\u0422\u0412\u041e \u041e\u041f\u0415\u0420\u0410\u0422\u041e\u0420\u0410 \u0410\u0411\u0412\u0413.00001-01 34 01 <p>\u041b\u0438\u0441\u0442\u043e\u0432 4</p> <p></p> <p>\u041c\u043e\u0441\u043a\u0432\u043